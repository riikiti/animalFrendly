# Единый .env для docker-compose.prod.yml — см. docs/deploy/03-vps-guide.md (Вариант B).
# В отличие от backend/.env.example (локальная разработка, всё на 127.0.0.1), здесь хосты
# сервисов — имена контейнеров docker-compose (postgres/redis/meilisearch/minio/websocket),
# т.к. контейнеры общаются друг с другом по внутренней docker-сети, а не через localhost.

DOMAIN=animalfriendly.ru
IMAGE_TAG=latest

APP_NAME=AnimalFriendly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://${DOMAIN}

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=animalfriendly
DB_USERNAME=animalfriendly
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@animalfriendly.ru"
MAIL_FROM_NAME="${APP_NAME}"

# MinIO (self-hosted S3) — для внешнего облачного S3 заменить AWS_ENDPOINT на его адрес и
# убрать сервис minio из docker-compose.prod.yml. Бакет создаётся один раз вручную
# (`docker compose exec minio mc mb local/animalfriendly` или через консоль MinIO на :9001).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=animalfriendly
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MEILISEARCH_HOST=http://meilisearch:7700
# Минимум 16 байт — в MEILI_ENV=production Meilisearch отказывается стартовать с более
# коротким ключом.
MEILISEARCH_KEY=

# Yandex Geocoder — адрес пользователя -> координаты/город
YANDEX_GEOCODER_API_KEY=

# ЮKassa — см. docs/plan/10-integrations.md, docs/rules/04-payments-escrow.md
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_VERIFY_WEBHOOK_IP=true
YOOKASSA_COMMISSION_BASIS_POINTS=500
YOOKASSA_ESCROW_HOLD_DAYS=7
YOOKASSA_PAYOUTS_ENABLED=false

# Firebase Cloud Messaging — push-уведомления
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Laravel Reverb — REVERB_HOST здесь внутренний (backend публикует события контейнеру
# websocket напрямую по docker-сети); публично браузер стучится через Caddy на /app/*
# (см. deploy/Caddyfile), поэтому VITE_REVERB_* ниже указывают на домен, а не на "websocket".
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=websocket
REVERB_PORT=8080
REVERB_SCHEME=http

CORS_ALLOWED_ORIGINS=https://${DOMAIN}
FRONTEND_URL=https://${DOMAIN}
