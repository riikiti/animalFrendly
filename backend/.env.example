APP_NAME=AnimalFriendly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=animalfriendly
DB_USERNAME=animalfriendly
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@animalfriendly.ru"
MAIL_FROM_NAME="${APP_NAME}"

# S3-совместимое хранилище (локально — MinIO из docker-compose.yml)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# Yandex Geocoder — адрес пользователя -> координаты/город
YANDEX_GEOCODER_API_KEY=

# ЮKassa — см. docs/plan/10-integrations.md, docs/rules/04-payments-escrow.md
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_VERIFY_WEBHOOK_IP=true
# YOOKASSA_WEBHOOK_IP_RANGES=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32
YOOKASSA_COMMISSION_BASIS_POINTS=500
YOOKASSA_ESCROW_HOLD_DAYS=7
YOOKASSA_PAYOUTS_ENABLED=false

# Firebase Cloud Messaging — push-уведомления
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# Laravel Reverb — WebSocket (чат в реальном времени)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"
VITE_API_URL=http://localhost:8000
